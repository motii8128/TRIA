<launch>
    <!-- 上下機構パラメータ -->
    <arg name="vertical.pos.p_gain" default="12000.0"/>
    <arg name="vertical.pos.i_gain" default="0.0"/>
    <arg name="vertical.pos.d_gain" default="0.0"/>
    <arg name="vertical.pos.max_output" default="8000.0"/>
    <arg name="vertical.pos.max_integral" default="1000.0"/>

    <arg name="vertical.vel.p_gain" default="0.31"/>
    <arg name="vertical.vel.i_gain" default="0.0"/>
    <arg name="vertical.vel.d_gain" default="0.01"/>
    <arg name="vertical.vel.max_output" default="8000.0"/>
    <arg name="vertical.vel.max_integral" default="1000.0"/>

    <!-- 水平移動機構パラメータ -->
    <arg name="horizontal.pos.p_gain" default="12000.0"/>
    <arg name="horizontal.pos.i_gain" default="0.0"/>
    <arg name="horizontal.pos.d_gain" default="0.0"/>
    <arg name="horizontal.pos.max_output" default="8000.0"/>
    <arg name="horizontal.pos.max_integral" default="1000.0"/>

    <arg name="horizontal.vel.p_gain" default="0.31"/>
    <arg name="horizontal.vel.i_gain" default="0.0"/>
    <arg name="horizontal.vel.d_gain" default="0.01"/>
    <arg name="horizontal.vel.max_output" default="8000.0"/>
    <arg name="horizontal.vel.max_integral" default="1000.0"/>

    <!-- ハンド機構パラメータ -->
    <arg name="hand.pos.p_gain" default="12000.0"/>
    <arg name="hand.pos.i_gain" default="0.0"/>
    <arg name="hand.pos.d_gain" default="0.0"/>
    <arg name="hand.pos.max_output" default="7000.0"/>
    <arg name="hand.pos.max_integral" default="1000.0"/>

    <arg name="hand.vel.p_gain" default="0.25"/>
    <arg name="hand.vel.i_gain" default="0.01"/>
    <arg name="hand.vel.d_gain" default="0.007"/>
    <arg name="hand.vel.max_output" default="8000.0"/>
    <arg name="hand.vel.max_integral" default="1000.0"/>


    <!-- ノードの起動 -->
    <node pkg="machine_controller" exec="motor_controller" name="vertical_controller" output="screen">
        <!-- パラメータを直接指定 -->
        <param name="pos.p_gain" value="$(var vertical.pos.p_gain)"/>
        <param name="pos.i_gain" value="$(var vertical.pos.i_gain)"/>
        <param name="pos.d_gain" value="$(var vertical.pos.d_gain)"/>
        <param name="pos.max_output" value="$(var vertical.pos.max_output)"/>
        <param name="pos.max_integral" value="$(var vertical.pos.max_integral)"/>
        <param name="vel.p_gain" value="$(var vertical.vel.p_gain)"/>
        <param name="vel.i_gain" value="$(var vertical.vel.i_gain)"/>
        <param name="vel.d_gain" value="$(var vertical.vel.d_gain)"/>
        <param name="vel.max_output" value="$(var vertical.vel.max_output)"/>
        <param name="vel.max_integral" value="$(var vertical.vel.max_integral)"/>

        <!-- トピックのremap -->
        <remap from="/target" to="/machine/target/vertical"/>
        <remap from="/feedback" to="/ccb/feedback/vertical"/>
        <remap from="/target_currnet" to="/machine/current/vertical"/>
    </node>

    <node pkg="machine_controller" exec="motor_controller" name="horizontal_controller" output="screen">
        <!-- パラメータを直接指定 -->
        <param name="pos.p_gain" value="$(var horizontal.pos.p_gain)"/>
        <param name="pos.i_gain" value="$(var horizontal.pos.i_gain)"/>
        <param name="pos.d_gain" value="$(var horizontal.pos.d_gain)"/>
        <param name="pos.max_output" value="$(var horizontal.pos.max_output)"/>
        <param name="pos.max_integral" value="$(var horizontal.pos.max_integral)"/>
        <param name="vel.p_gain" value="$(var horizontal.vel.p_gain)"/>
        <param name="vel.i_gain" value="$(var horizontal.vel.i_gain)"/>
        <param name="vel.d_gain" value="$(var horizontal.vel.d_gain)"/>
        <param name="vel.max_output" value="$(var horizontal.vel.max_output)"/>
        <param name="vel.max_integral" value="$(var horizontal.vel.max_integral)"/>

        <!-- トピックのremap -->
        <remap from="/target" to="/machine/target/horizontal"/>
        <remap from="/feedback" to="/ccb/feedback/horizontal"/>
        <remap from="/target_currnet" to="/machine/current/horizontal"/>
    </node>

    <node pkg="machine_controller" exec="motor_controller" name="hand_controller" output="screen">
        <!-- パラメータを直接指定 -->
        <param name="pos.p_gain" value="$(var hand.pos.p_gain)"/>
        <param name="pos.i_gain" value="$(var hand.pos.i_gain)"/>
        <param name="pos.d_gain" value="$(var hand.pos.d_gain)"/>
        <param name="pos.max_output" value="$(var hand.pos.max_output)"/>
        <param name="pos.max_integral" value="$(var hand.pos.max_integral)"/>
        <param name="vel.p_gain" value="$(var hand.vel.p_gain)"/>
        <param name="vel.i_gain" value="$(var hand.vel.i_gain)"/>
        <param name="vel.d_gain" value="$(var hand.vel.d_gain)"/>
        <param name="vel.max_output" value="$(var hand.vel.max_output)"/>
        <param name="vel.max_integral" value="$(var hand.vel.max_integral)"/>

        <!-- トピックのremap -->
        <remap from="/target" to="/machine/target/hand"/>
        <remap from="/feedback" to="/ccb/feedback/hand"/>
        <remap from="/target_currnet" to="/machine/current/hand"/>
    </node>
</launch>