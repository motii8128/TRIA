<launch>
    <!-- 上昇機構 -->
    <node pkg="machine_controller" exec="cascade_position_controller" name="vertical_controller" output="screen">
        <!-- パラメータを直接指定 -->
        <param name="pos.p_gain" value="200.0"/>
        <param name="pos.i_gain" value="0.0"/>
        <param name="pos.d_gain" value="0.0"/>
        <param name="pos.max_output" value="6000.0"/>
        <param name="pos.max_integral" value="1000.0"/>

        <param name="vel.p_gain" value="0.25"/>
        <param name="vel.i_gain" value="0.1"/>
        <param name="vel.d_gain" value="0.001"/>
        <param name="vel.max_output" value="5000.0"/>
        <param name="vel.max_integral" value="5000.0"/>

        <param name="goal_threshold" value="1.0"/>

        <!-- トピックのremap -->
        <remap from="/feedback" to="/ccb/feedback/vertical"/>
        <remap from="/target_current" to="/machine/current/vertical"/>
        <remap from="machine_action" to="/action/machine/vertical"/>
    </node>

    <!-- 水平移動機構 -->
    <node pkg="machine_controller" exec="cascade_position_controller" name="horizontal_controller" output="screen">
        <!-- パラメータを直接指定 -->
        <param name="pos.p_gain" value="200.0"/>
        <param name="pos.i_gain" value="0.0"/>
        <param name="pos.d_gain" value="0.0"/>
        <param name="pos.max_output" value="6000.0"/>
        <param name="pos.max_integral" value="1000.0"/>

        <param name="vel.p_gain" value="0.25"/>
        <param name="vel.i_gain" value="0.1"/>
        <param name="vel.d_gain" value="0.003"/>
        <param name="vel.max_output" value="5000.0"/>
        <param name="vel.max_integral" value="2000.0"/>

        <param name="goal_threshold" value="1.0"/>

        <!-- トピックのremap -->
        <remap from="/feedback" to="/ccb/feedback/horizontal"/>
        <remap from="/target_current" to="/machine/current/horizontal"/>
        <remap from="machine_action" to="/action/machine/horizontal"/>
    </node>

    <!-- ハンド機構 -->
    <node pkg="machine_controller" exec="cascade_position_controller" name="hand_controller" output="screen">
        <!-- パラメータを直接指定 -->
        <param name="pos.p_gain" value="800.0"/>
        <param name="pos.i_gain" value="0.0"/>
        <param name="pos.d_gain" value="0.0"/>
        <param name="pos.max_output" value="5000.0"/>
        <param name="pos.max_integral" value="1000.0"/>

        <param name="vel.p_gain" value="0.25"/>
        <param name="vel.i_gain" value="0.0"/>
        <param name="vel.d_gain" value="0.001"/>
        <param name="vel.max_output" value="5000.0"/>
        <param name="vel.max_integral" value="1000.0"/>

        <param name="goal_threshold" value="3.0"/>

        <!-- トピックのremap -->
        <remap from="/feedback" to="/ccb/feedback/hand"/>
        <remap from="/target_current" to="/machine/current/hand"/>
        <remap from="machine_action" to="/action/machine/hand"/>
    </node>
</launch>