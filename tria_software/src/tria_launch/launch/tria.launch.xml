<launch>
  <!-- 制御マイコンとの通信 -->
  <include file="$(find-pkg-share tria_launch)/launch/device_communicator/ccb_communicator.launch.xml" />
  <!-- ゲームコントローラーとの通信 -->
  <include file="$(find-pkg-share tria_launch)/launch/device_communicator/game_controller_communicator.launch.xml" />
  <include file="$(find-pkg-share tria_launch)/launch/device_communicator/joy.launch.xml" />
  <!-- Webアプリとの通信 -->
  <include file="$(find-pkg-share tria_launch)/launch/device_communicator/web_ui_connector.launch.xml" />

  <!-- 自動制御のタスク管理 -->
  <include file="$(find-pkg-share tria_launch)/launch/tria_auto_core/task_manager.launch.xml" />

  <!-- 自己位置推定 -->
  <include file="$(find-pkg-share tria_launch)/launch/tria_localization/lidar_only_odometry.launch.xml" /> 
  <!-- 静的変換 -->
  <include file="$(find-pkg-share tria_launch)/launch/tria_localization/static_tf.launch.xml" />

  <!-- 機構のPID制御 -->
  <include file="$(find-pkg-share tria_launch)/launch/machine_controller/pid_controller.launch.xml" />

  <!-- 足回りの比例制御＆運動学 -->
  <include file="$(find-pkg-share tria_launch)/launch/wheel_controller/simple_controller.launch.xml" />

  <!-- YD LiDARドライバ -->
  <include file="$(find-pkg-share tria_launch)/launch/ydlidar_tmini_driver/tmini_driver.launch.xml" />
  <!-- ２つの点群を統合するやつ -->
  <include file="$(find-pkg-share tria_launch)/launch/ydlidar_tmini_driver/tmini_merger_node.launch.xml" />

</launch>