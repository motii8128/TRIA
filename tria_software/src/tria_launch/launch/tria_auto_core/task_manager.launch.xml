<launch>
  <!-- ノードの起動 -->
  <node pkg="tria_auto_core" exec="task_manager" output="screen">
    <!-- パラメータを直接指定 -->
    <!-- 回収するときの水平移動機構の目標位置 -->
    <param name="collect_horizontal_pos" value="-1.75"/>
    <!-- 回収するときの上下移動機構の目標位置 -->
    <param name="collect_vertical_pos" value="-1.5"/>
    <!-- 回収するときのハンド機構の目標位置 -->
    <param name="collect_hand_pos" value="-0.43"/>
    <!-- 機構制御を始める点と目標位置の距離 -->
    <param name="enable_arm_distance" value="0.1"/>
    <!-- 最大展開時のアームの長さ -->
    <param name="arm_length" value="0.52"/>

    <!-- トピックのremap -->
    <remap from="/task" to="/task"/>
    <remap from="/action/wheel" to="/action/wheel"/>
    <remap from="/action/machine/vertical" to="/action/machine/vertical"/>
    <remap from="/action/machine/horizontal" to="/action/machine/horizontal"/>
    <remap from="/action/machine/hand" to="/action/machine/hand"/>
  </node>
</launch>