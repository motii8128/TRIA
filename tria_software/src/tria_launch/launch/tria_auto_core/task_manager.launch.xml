<launch>
  <!-- ノードの起動 -->
  <node pkg="tria_auto_core" exec="task_manager" output="screen">
    <!-- パラメータを直接指定 -->
     <!-- ゴールとみなす目的位置との許容誤差 -->
    <param name="position_goal_threshold" value="0.02"/>
    <!-- ゴールとみなす機構制御の許容誤差 -->
    <param name="arm_goal_threshold" value="0.01"/>
    <!-- ハンド -->
    <param name="hand_goal_threshold" value="0.01"/>

    <!-- 回収するときの水平移動機構の目標位置 -->
    <param name="collect_horizontal_pos" value="-1.75"/>
    <!-- 回収するときの上下移動機構の目標位置 -->
    <param name="collect_vertical_pos" value="-1.5"/>
    <!-- 回収するときのハンド機構の目標位置 -->
    <param name="collect_hand_pos" value="-0.23"/>

    <!-- 機構制御を始める点と目標位置の距離 -->
    <param name="enable_arm_distance" value="0.3"/>
    <!-- 物を掴んだとみなすトルクの値 -->
    <param name="torque_threshold" value="200"/>

    <!-- 最大展開時のアームの長さ -->
    <param name="arm_length" value="0.3"/>

    <!-- トピックのremap -->
    <remap from="/task" to="/task"/>
    <remap from="/machine_control" to="/machine_control"/>
    <remap from="/target_pose" to="/target_pose"/>
    <remap from="/ccb/sensor_feedback" to="/ccb/sensor_feedback"/>
  </node>
</launch>