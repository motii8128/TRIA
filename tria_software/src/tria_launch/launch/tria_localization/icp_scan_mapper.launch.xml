<launch>
  <node pkg="tria_localization" exec="icp_scan_mapper" output="screen">
    <!-- パラメータを直接指定 -->
    <param name="max_iteration" value="500"/>
    <param name="tolerance" value="0.001"/>
    <param name="neighbor_threshold" value="0.1"/>

    <param name="resolution" value="0.01"/>
    <param name="min_range" value="0.01"/>
    <param name="max_range" value="10.0"/>
    <param name="l_occ" value="0.85"/>
    <param name="l_free" value="-0.4"/>
    <param name="l_min" value="-2.0"/>
    <param name="l_max" value="3.5"/>
    <param name="occupied_threshold" value="0.65"/>
    <param name="free_threshold" value="0.35"/>


    <!-- トピックのremap -->
    <remap from="/merged_points" to="/merged_points"/>
    <remap from="/odom" to="/odom"/>
    <remap from="/map" to="/map"/>
  </node>

</launch>