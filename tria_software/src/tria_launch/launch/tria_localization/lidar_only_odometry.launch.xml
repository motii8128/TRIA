<launch>
  <!-- ノードの起動 -->
  <node pkg="tria_localization" exec="lidar_only_odometer" output="screen">
    <!-- パラメータを直接指定 -->
    <param name="max_iteration" value="1000"/>
    <param name="tolerance" value="0.001"/>
    <param name="search_radius" value="0.2"/>
    <param name="neighbor_threshold" value="0.5"/>

    <!-- トピックのremap -->
    <remap from="/merged_points" to="/merged_points"/>
  </node>

</launch>